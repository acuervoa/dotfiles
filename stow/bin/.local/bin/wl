#!/usr/bin/env python3
"""wl — registro de trabajo por equipo, apto para git. Solo biblioteca estándar.

  wl "terminé la migración X"          hecho (por defecto)
  wl -l "grep -P no existe en BSD"     aprendizaje
  wl -d "SQLite antes que Postgres"    decisión
  wl -b "espero acceso al repo"        bloqueo
  wl -a NOMBRE [-l|-d|-b] "texto"      anota con identidad de agente (o WORKLOG_AGENT)
  wl today                             entradas de hoy de todos los equipos
  wl sync                              commit + pull --rebase + push de este equipo
  wl init GIT_URL [--host NOMBRE]      clona el repo y fija el nombre del equipo
                                       (adopta un directorio que solo contenga <equipo>/)
  wl daily --vault RUTA [--date D]     vuelca el día en DAILY/D.md (equipo del vault)

`-a NOMBRE` es una flag solo al inicio (junto a -l/-d/-b, en cualquier orden); `-a` tiene
prioridad sobre WORKLOG_AGENT. Sin agente, la entrada no lleva el campo `agente`.

Una frase que empiece por un subcomando se registra igual si no tiene la forma de
ese subcomando (`wl sync terminado con X` es una entrada, `wl sync` es el comando).

Datos: <WORKLOG_DIR>/<equipo>/AAAA-MM-DD.jsonl, un fichero por equipo y día, solo
se añaden líneas. Cada equipo escribe únicamente en su directorio, así que git no
genera conflictos.
"""
import glob
import json
import os
import re
import shlex
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import uuid
from datetime import date, datetime
from pathlib import Path

TYPES = {"hecho": "✅", "aprendizaje": "💡", "decision": "⚖️", "bloqueo": "⛔"}
FLAGS = {"-l": "aprendizaje", "-d": "decision", "-b": "bloqueo"}
START, END = "<!-- worklog:start -->", "<!-- worklog:end -->"
FIELDS = ("id", "ts", "host", "tipo", "texto")
HOST_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
DAY_FILE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}\.jsonl$")
AGENT_RE = HOST_RE  # mismo formato que el equipo; sin '/', para poder mostrar host/agente


def die(msg, code=1):
    print(f"wl: {msg}", file=sys.stderr)
    sys.exit(code)


def root() -> Path:
    return Path(os.environ.get("WORKLOG_DIR") or Path.home() / ".local/share/worklog")


def config_file() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config"
    return Path(base) / "worklog" / "host"


def valid_host(name) -> bool:
    return bool(name) and bool(HOST_RE.match(name))


def host() -> str:
    name = os.environ.get("WORKLOG_HOST")
    if not name and config_file().is_file():
        name = config_file().read_text(encoding="utf-8").strip()
    name = name or socket.gethostname()
    if not valid_host(name):
        die(f"nombre de equipo no válido: {name!r} (usa letras, cifras, '.', '_' o '-')")
    return name


def valid_agent(name) -> bool:
    return isinstance(name, str) and bool(AGENT_RE.match(name))


def cmd_add(argv):
    tipo, agente, words = "hecho", None, list(argv)
    while words:  # flags solo al inicio; lo que sigue a la primera palabra es texto
        if words[0] in FLAGS:
            tipo = FLAGS[words.pop(0)]
        elif words[0] == "-a":
            words.pop(0)
            if not words:
                die("-a requiere un nombre de agente")
            agente = words.pop(0)
            if not valid_agent(agente):
                die(f"nombre de agente no válido: {agente!r} (usa letras, cifras, '.', '_' o '-')")
        else:
            break
    if agente is None:
        agente = os.environ.get("WORKLOG_AGENT", "").strip() or None
        if agente is not None and not valid_agent(agente):
            die(f"WORKLOG_AGENT no válido: {agente!r} (usa letras, cifras, '.', '_' o '-')")
    texto = " ".join(" ".join(words).split())
    if not texto:
        die('falta el texto. Uso: wl [-a NOMBRE] [-l|-d|-b] "texto"')
    now = datetime.now().astimezone().replace(microsecond=0)
    h = host()
    # id aleatorio: dos entradas iguales en el mismo segundo siguen siendo dos
    entry = {"id": uuid.uuid4().hex[:12], "ts": now.isoformat(), "host": h, "tipo": tipo, "texto": texto}
    if agente:  # campo opcional: se omite la clave, nunca se escribe null
        entry["agente"] = agente
    path = root() / h / f"{now.date().isoformat()}.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    line = (json.dumps(entry, ensure_ascii=False) + "\n").encode("utf-8")
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, line)
        os.fsync(fd)
    finally:
        os.close(fd)
    print(f"{now:%H:%M} {TYPES[tipo]} {tipo} · {texto}")


def parse_entry(raw: str):
    e = json.loads(raw)
    if not isinstance(e, dict) or any(not isinstance(e.get(k), str) for k in FIELDS):
        raise ValueError("campos ausentes o de tipo incorrecto")
    ts = datetime.fromisoformat(e["ts"])
    e["_ts"] = ts if ts.tzinfo else ts.astimezone()  # sin offset: se toma como hora local
    return e


def load(day: str, base: Path) -> list:
    found = {}
    for p in sorted(base.glob(f"*/{day}.jsonl")):
        text = p.read_bytes().decode("utf-8", errors="replace")
        for n, raw in enumerate(text.splitlines(), 1):
            if not raw.strip():
                continue
            try:
                e = parse_entry(raw)
            except (ValueError, TypeError):  # JSONDecodeError y fromisoformat son ValueError
                print(f"wl: aviso: línea inválida {p.parent.name}/{p.name}:{n}", file=sys.stderr)
                continue
            e["_pos"] = (p.parent.name, n)  # orden de escritura dentro del fichero de cada equipo
            found[e["id"]] = e
    return sorted(found.values(), key=lambda e: (e["_ts"], e["_pos"]))


def fmt(e) -> str:
    agente = e.get("agente")
    who = f"{e['host']}/{agente}" if valid_agent(agente) else e["host"]
    return f"{e['_ts']:%H:%M} {TYPES.get(e['tipo'], '•')} {e['tipo']} · {e['texto']} [{who}]"


def cmd_today(_argv):
    entries = load(date.today().isoformat(), root())
    if not entries:
        print("sin entradas hoy")
    for e in entries:
        print(fmt(e))


def safe(s: str) -> str:
    """Texto de usuario dentro del bloque de la daily: nunca puede reproducir un marcador."""
    return s.replace("<!--", "&lt;!--").replace("-->", "--&gt;").replace("`", "'")


def render(entries) -> str:
    lines = [START, "## 🧾 Registro", ""]
    for e in entries:
        lines.append(
            f"- {e['_ts']:%H:%M} {TYPES.get(e['tipo'], '•')} **{safe(e['tipo'])}** · "
            f"{safe(e['texto'])} `{safe(e['host'])}`"
        )
    lines.append(END)
    return "\n".join(lines)


def git(*args, check=False):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")  # nunca esperar una credencial
    return subprocess.run(["git", "-C", str(root()), *args], text=True, capture_output=True, check=check, env=env)


def cmd_init(argv):
    url, name, rest = None, None, list(argv)
    while rest:
        a = rest.pop(0)
        if a == "--host":
            if not rest:
                die("--host requiere un nombre")
            name = rest.pop(0)
        elif url is None:
            url = a
        else:
            die(f"argumento desconocido: {a}")
    if not url:
        die("uso: wl init GIT_URL [--host NOMBRE]")
    if url.startswith("-"):
        die(f"URL no válida: {url!r}")
    if name is not None and not valid_host(name):
        die(f"nombre de equipo no válido: {name!r}")
    r = root()
    pending_adoptions(r)
    if not (r.exists() and any(r.iterdir())):
        clone_into(url, r)
        if name:
            cfg = config_file()
            cfg.parent.mkdir(parents=True, exist_ok=True)
            cfg.write_text(name + "\n", encoding="utf-8")
        print(f"listo: equipo={host()} datos={root()}")
        return
    local = adoptable(r)
    if local is None:
        die(f"{r} ya existe y no está vacío; solo se adopta un directorio que contenga únicamente "
            "<equipo>/ con ficheros AAAA-MM-DD.jsonl")
    eff = os.environ.get("WORKLOG_HOST") or name or host()
    if not valid_host(eff):
        die(f"nombre de equipo no válido: {eff!r}")
    if local[0] != eff:
        die(f"{r} ya existe y no está vacío; hay datos locales de {local[0]}/; "
            f"usa --host {local[0]} o WORKLOG_HOST={local[0]}")
    env_host = os.environ.get("WORKLOG_HOST")
    if env_host and name and env_host != name:
        die(f"WORKLOG_HOST={env_host} y --host {name} difieren; usa el mismo valor en ambos o elimina uno")
    adopt(url, name, r, eff, local[1])
    print(f"listo: equipo={host()} datos={root()}")


def clone_into(url, dest):
    r = subprocess.run(["git", "clone", "--", url, str(dest)], text=True)
    if r.returncode:
        die("git clone falló", r.returncode)


def is_real_dir(p) -> bool:
    try:
        return stat.S_ISDIR(os.lstat(p).st_mode)
    except OSError:
        return False


def pending_adoptions(r: Path):
    """Un `.<root>.init-*` con ADOPTING y clone/<equipo> guarda datos de usuario sin recuperar."""
    pattern = os.path.join(glob.escape(str(r.parent)), glob.escape(f".{r.name}.init-") + "*")
    for t in sorted(glob.glob(pattern)):
        if not is_real_dir(t):
            continue
        try:
            with open(os.path.join(t, "ADOPTING"), encoding="utf-8") as f:
                eff = f.read().strip()
        except OSError:
            continue
        held = os.path.join(t, "clone", eff)
        if not valid_host(eff) or not os.path.lexists(held):
            continue
        dest = r / eff
        state = (f"{dest} existe (datos posteriores a la adopción)" if os.path.lexists(dest)
                 else f"{dest} no existe")
        die(f"hay datos locales sin recuperar de una adopción interrumpida; no se toca nada.\n"
            f"  datos originales de {eff}/: {held}\n"
            f"  destino: {state}\n"
            f"  recuperación manual: combina a mano el contenido de {held} con {dest} "
            f"(si {dest} no existe: mv {shlex.quote(held)} {shlex.quote(str(dest))}), "
            f"comprueba el resultado y borra {t}")


def adoptable(r: Path):
    """(equipo, ficheros) si root solo contiene <equipo>/ con AAAA-MM-DD.jsonl regulares; si no, None."""
    try:
        if not is_real_dir(r) or os.stat(r).st_dev != os.stat(r.parent).st_dev:
            return None
        kids = os.listdir(r)
        if len(kids) != 1 or not is_real_dir(r / kids[0]):
            return None
        files = os.listdir(r / kids[0])
        for f in files:
            if not DAY_FILE_RE.match(f) or not stat.S_ISREG(os.lstat(r / kids[0] / f).st_mode):
                return None
    except OSError:
        return None
    return kids[0], sorted(files)


def sq(s) -> str:
    return "'" + str(s).replace("'", "'\\''") + "'"


def adopt(url, name, r: Path, eff, files):
    """Clona en un temporal hermano, mueve <eff>/ dentro del clon y lo deja como root.

    scratch=True solo mientras el temporal no contiene ni puede contener datos del usuario;
    se desactiva ANTES del rename A y solo se reactiva si se acredita el estado real
    (datos en root y nada en el clon). Ante cualquier duda se conserva el temporal."""
    cfg = config_file()
    try:
        t = tempfile.mkdtemp(dir=r.parent, prefix=f".{r.name}.init-")
    except OSError as e:
        die(f"no se puede crear un temporal junto a {r}: {e}")
    clone, held, dest = os.path.join(t, "clone"), os.path.join(t, "clone", eff), r / eff
    cfg_tmp = None
    scratch = True
    adopted = False
    try:
        res = subprocess.run(["git", "clone", "--", url, clone], text=True)
        if res.returncode:
            die("git clone falló", res.returncode)
        if os.path.lexists(held):
            die(f"el remoto ya contiene {eff}/; no se adopta ni se mezcla; datos locales intactos")
        probe = [eff, *(f"{eff}/{f}" for f in files), f"{eff}/{date.today().isoformat()}.jsonl"]
        chk = subprocess.run(["git", "-C", clone, "check-ignore", "-z", "--stdin"], text=True,
                             input="\0".join(probe) + "\0", capture_output=True)
        if chk.returncode != 0 and chk.returncode != 1:
            die(f"no se pudo comprobar las exclusiones de Git ({chk.stderr.strip()}); datos locales intactos")
        if chk.returncode == 0:
            die(f"las exclusiones de Git del repositorio (.gitignore, info/exclude o globales) ignoran "
                f"{eff}/ o sus ficheros; wl sync no los publicaría; no se adopta, datos locales intactos")
        try:
            if name:
                cfg.parent.mkdir(parents=True, exist_ok=True)
                fd, cfg_tmp = tempfile.mkstemp(dir=cfg.parent, prefix=".host.")
                with os.fdopen(fd, "w", encoding="utf-8") as f:
                    f.write(name + "\n")
            with open(os.path.join(t, "ADOPTING"), "w", encoding="utf-8") as f:
                f.write(eff + "\n")
        except OSError as e:
            die(f"no se pudo preparar la adopción: {e}; datos locales intactos")
        scratch = False  # desde aquí el temporal puede contener datos del usuario
        try:
            os.rename(dest, held)  # A: los datos locales pasan al clon
        except OSError as e:
            if os.path.lexists(dest) and not os.path.lexists(held):
                scratch = True  # acreditado: los datos siguen en root y el clon no los contiene
                die(f"no se pudo mover {dest}: {e}; datos locales intactos")
            die(f"el movimiento de {dest} falló ({e}) y no se puede acreditar dónde están los datos; "
                f"no se borra nada.\n  posible ubicación de los datos originales: {held}\n"
                f"  ubicación original: {dest}\n"
                f"  recuperación manual: localiza los datos en una de las dos rutas, devuélvelos a {dest} "
                f"y borra {t};\n  mientras exista {t}, wl init se niega")
        try:
            os.rename(clone, r)  # B: el clon pasa a ser root
        except OSError as e:
            if cfg_tmp:  # temporal de config: nada del usuario, se puede descartar
                Path(cfg_tmp).unlink(missing_ok=True)
                cfg_tmp = None
            try:
                os.rename(held, dest)  # rollback de A
            except OSError as e2:
                die(f"no se pudo completar la adopción ({e}) ni deshacerla ({e2}); no se borra nada.\n"
                    f"  datos originales: {held}\n  contenido actual de {dest}: lo escrito después de mover\n"
                    f"  recuperación manual: combina a mano {held} con {dest} y borra {t};\n"
                    f"  mientras exista {t}, wl init se niega")
            if os.path.lexists(dest) and not os.path.lexists(held):
                scratch = True  # acreditado: restaurados en root y el clon ya no los contiene
                die(f"no se pudo completar la adopción ({e}); datos locales restaurados e intactos")
            die(f"no se pudo completar la adopción ({e}); no se puede acreditar la restauración; no se borra nada.\n"
                f"  datos originales: {held} o {dest}\n"
                f"  recuperación manual: verifica ambas rutas y borra {t} cuando los datos estén en {dest};\n"
                f"  mientras exista {t}, wl init se niega")
        # los datos ya están en root/<eff>: a partir de aquí no se deshace nada
        adopted = True
        if cfg_tmp:
            try:
                os.replace(cfg_tmp, cfg)
                cfg_tmp = None
            except OSError as e:
                die(f"adopción incompleta ({e}): datos adoptados en {dest}; configuración pendiente: "
                    f"printf '%s\\n' {sq(name)} > {sq(cfg)}; "
                    f"pueden borrarse el temporal {cfg_tmp} y el directorio {t}")
        try:
            os.unlink(os.path.join(t, "ADOPTING"))
            os.rmdir(t)
        except OSError as e:
            die(f"adopción completada pero no se pudo limpiar el temporal ({e}): datos adoptados en {dest}"
                + ("" if not name else f", configuración escrita en {cfg}") + f"; puede borrarse {t}")
        t = None
        print(f"wl: adoptadas entradas locales de {eff}/ (sin confirmar; wl sync las publica)", file=sys.stderr)
    finally:
        if scratch and t:
            shutil.rmtree(t, ignore_errors=True)
        if cfg_tmp and not adopted:  # temporal de config: nada del usuario
            Path(cfg_tmp).unlink(missing_ok=True)


def cmd_sync(_argv):
    if not (root() / ".git").exists():
        die(f"{root()} no es un repositorio; usa wl init")
    if git("remote", "get-url", "origin").returncode:
        die("el repositorio no tiene remoto 'origin'")
    h = host()
    if (root() / h).is_dir():  # un equipo sin registros propios solo hace pull
        added = git("add", "-A", "--", h)
        if added.returncode:
            die("git add falló\n" + added.stderr.strip())
        # solo este directorio: lo que el usuario tenga en el índice no se arrastra
        if git("diff", "--cached", "--quiet", "--", h).returncode:
            msg = f"worklog: {h} {datetime.now().astimezone():%Y-%m-%d %H:%M}"
            commit = git("commit", "-m", msg, "--", h)
            if commit.returncode:
                die("git commit falló\n" + (commit.stderr.strip() or commit.stdout.strip()))
    dirty = git("status", "--porcelain").stdout.strip()
    if dirty:
        die("hay cambios sin confirmar fuera del directorio de este equipo; "
            "no se sincroniza para no mezclarlos:\n" + dirty)
    remote_has_branch = bool(git("ls-remote", "--heads", "origin").stdout.strip())
    if remote_has_branch:
        pull = git("pull", "--rebase")
        if pull.returncode:
            git("rebase", "--abort")  # no dejar el clon a medio rebase
            die("sin red o conflicto al hacer pull; las entradas están a salvo en local\n"
                + pull.stderr.strip(), 2)
    if git("rev-parse", "--verify", "-q", "HEAD").returncode:  # repo sin commits: nada que publicar
        die("no hay entradas que sincronizar: el repositorio aún no tiene commits; "
            'registra una con wl "texto" y vuelve a ejecutar wl sync', 2)
    push = git("push", "-u", "origin", "HEAD")  # -u: también vale para el primer push a un repo vacío
    if push.returncode:
        die("push falló; las entradas están a salvo en local\n" + push.stderr.strip(), 2)
    print("sincronizado")


def cmd_daily(argv):
    vault = day = None
    rest = list(argv)
    while rest:
        a = rest.pop(0)
        if a in ("--vault", "--date"):
            if not rest or rest[0].startswith("--"):
                die(f"{a} requiere un valor")
            if a == "--vault":
                vault = rest.pop(0)
            else:
                day = rest.pop(0)
        else:
            die(f"argumento desconocido: {a}")
    if not vault:
        die("uso: wl daily --vault RUTA [--date AAAA-MM-DD]")
    day = day or date.today().isoformat()
    try:
        date.fromisoformat(day)
    except ValueError:
        die(f"fecha no válida: {day}")
    note = Path(vault).expanduser() / "DAILY" / f"{day}.md"
    if not note.is_file():
        die(f"no existe {note}; la crea el timer de la daily, no este script")
    note = note.resolve()  # si es un enlace simbólico, se actualiza el destino
    entries = load(day, root())
    if not entries:
        print("sin entradas; no se toca la daily")
        return
    mtime = note.stat().st_mtime_ns
    text = note.read_bytes().decode("utf-8")
    eol = "\r\n" if "\r\n" in text else "\n"
    block = render(entries).replace("\n", eol)
    i, j = text.find(START), text.find(END)
    if (i == -1) != (j == -1) or (i != -1 and j < i):
        die("marcadores de worklog incompletos o desordenados en la daily; no se toca")
    if i != -1:
        new = text[:i] + block + text[j + len(END):]
    else:
        new = text.rstrip("\r\n") + eol + eol + block + eol
    if new == text:
        print("sin cambios")
        return
    fd, tmp = tempfile.mkstemp(dir=note.parent, prefix=f".{note.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(new.encode("utf-8"))
        os.chmod(tmp, note.stat().st_mode & 0o777)
        if note.stat().st_mtime_ns != mtime:
            die("la daily cambió mientras se actualizaba; vuelve a ejecutar")
        os.replace(tmp, note)
    finally:
        Path(tmp).unlink(missing_ok=True)
    print(f"{note}: {len(entries)} entradas")


def is_command(argv) -> bool:
    """¿Esto es el subcomando o una frase que casualmente empieza igual?"""
    cmd, rest = argv[0], argv[1:]
    if cmd in ("today", "sync"):
        return not rest
    if cmd == "daily":
        return (not rest or rest[0].startswith("--")
                or re.fullmatch(r"\d{4}-\d{2}-\d{2}", rest[0]) is not None)
    if cmd == "init":
        return bool(rest) and (rest[0] == "--host" or (not rest[0].startswith("-") and (":" in rest[0] or "/" in rest[0])))
    return False


COMMANDS = {"today": cmd_today, "sync": cmd_sync, "init": cmd_init, "daily": cmd_daily}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help") and len(argv) == 1:
        print(__doc__)
        return
    if argv[0] in COMMANDS and is_command(argv):
        COMMANDS[argv[0]](argv[1:])
    else:
        cmd_add(argv)


if __name__ == "__main__":
    main(sys.argv[1:])
