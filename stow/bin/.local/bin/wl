#!/usr/bin/env python3
"""wl — registro de trabajo por equipo, apto para git. Solo biblioteca estándar.

  wl "terminé la migración X"          hecho (por defecto)
  wl -l "grep -P no existe en BSD"     aprendizaje
  wl -d "SQLite antes que Postgres"    decisión
  wl -b "espero acceso al repo"        bloqueo
  wl today                             entradas de hoy de todos los equipos
  wl sync                              commit + pull --rebase + push de este equipo
  wl init GIT_URL [--host NOMBRE]      clona el repo y fija el nombre del equipo
  wl daily --vault RUTA [--date D]     vuelca el día en DAILY/D.md (equipo del vault)

Una frase que empiece por un subcomando se registra igual si no tiene la forma de
ese subcomando (`wl sync terminado con X` es una entrada, `wl sync` es el comando).

Datos: <WORKLOG_DIR>/<equipo>/AAAA-MM-DD.jsonl, un fichero por equipo y día, solo
se añaden líneas. Cada equipo escribe únicamente en su directorio, así que git no
genera conflictos.
"""
import json
import os
import re
import socket
import subprocess
import sys
import tempfile
import uuid
from datetime import date, datetime
from pathlib import Path

TYPES = {"hecho": "✅", "aprendizaje": "💡", "decision": "⚖️", "bloqueo": "⛔"}
FLAGS = {"-l": "aprendizaje", "-d": "decision", "-b": "bloqueo"}
START, END = "<!-- worklog:start -->", "<!-- worklog:end -->"
FIELDS = ("id", "ts", "host", "tipo", "texto")
HOST_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def die(msg, code=1):
    print(f"wl: {msg}", file=sys.stderr)
    sys.exit(code)


def root() -> Path:
    return Path(os.environ.get("WORKLOG_DIR") or Path.home() / ".local/share/worklog")


def config_file() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config"
    return Path(base) / "worklog" / "host"


def valid_host(name) -> bool:
    return bool(name) and bool(HOST_RE.match(name))


def host() -> str:
    name = os.environ.get("WORKLOG_HOST")
    if not name and config_file().is_file():
        name = config_file().read_text(encoding="utf-8").strip()
    name = name or socket.gethostname()
    if not valid_host(name):
        die(f"nombre de equipo no válido: {name!r} (usa letras, cifras, '.', '_' o '-')")
    return name


def cmd_add(argv):
    tipo, words = "hecho", []
    for a in argv:
        if not words and a in FLAGS:
            tipo = FLAGS[a]
        else:
            words.append(a)
    texto = " ".join(" ".join(words).split())
    if not texto:
        die('falta el texto. Uso: wl [-l|-d|-b] "texto"')
    now = datetime.now().astimezone().replace(microsecond=0)
    h = host()
    # id aleatorio: dos entradas iguales en el mismo segundo siguen siendo dos
    entry = {"id": uuid.uuid4().hex[:12], "ts": now.isoformat(), "host": h, "tipo": tipo, "texto": texto}
    path = root() / h / f"{now.date().isoformat()}.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    line = (json.dumps(entry, ensure_ascii=False) + "\n").encode("utf-8")
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, line)
        os.fsync(fd)
    finally:
        os.close(fd)
    print(f"{now:%H:%M} {TYPES[tipo]} {tipo} · {texto}")


def parse_entry(raw: str):
    e = json.loads(raw)
    if not isinstance(e, dict) or any(not isinstance(e.get(k), str) for k in FIELDS):
        raise ValueError("campos ausentes o de tipo incorrecto")
    ts = datetime.fromisoformat(e["ts"])
    e["_ts"] = ts if ts.tzinfo else ts.astimezone()  # sin offset: se toma como hora local
    return e


def load(day: str, base: Path) -> list:
    found = {}
    for p in sorted(base.glob(f"*/{day}.jsonl")):
        text = p.read_bytes().decode("utf-8", errors="replace")
        for n, raw in enumerate(text.splitlines(), 1):
            if not raw.strip():
                continue
            try:
                e = parse_entry(raw)
            except (ValueError, TypeError):  # JSONDecodeError y fromisoformat son ValueError
                print(f"wl: aviso: línea inválida {p.parent.name}/{p.name}:{n}", file=sys.stderr)
                continue
            e["_pos"] = (p.parent.name, n)  # orden de escritura dentro del fichero de cada equipo
            found[e["id"]] = e
    return sorted(found.values(), key=lambda e: (e["_ts"], e["_pos"]))


def fmt(e) -> str:
    return f"{e['_ts']:%H:%M} {TYPES.get(e['tipo'], '•')} {e['tipo']} · {e['texto']} [{e['host']}]"


def cmd_today(_argv):
    entries = load(date.today().isoformat(), root())
    if not entries:
        print("sin entradas hoy")
    for e in entries:
        print(fmt(e))


def safe(s: str) -> str:
    """Texto de usuario dentro del bloque de la daily: nunca puede reproducir un marcador."""
    return s.replace("<!--", "&lt;!--").replace("-->", "--&gt;").replace("`", "'")


def render(entries) -> str:
    lines = [START, "## 🧾 Registro", ""]
    for e in entries:
        lines.append(
            f"- {e['_ts']:%H:%M} {TYPES.get(e['tipo'], '•')} **{safe(e['tipo'])}** · "
            f"{safe(e['texto'])} `{safe(e['host'])}`"
        )
    lines.append(END)
    return "\n".join(lines)


def git(*args, check=False):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")  # nunca esperar una credencial
    return subprocess.run(["git", "-C", str(root()), *args], text=True, capture_output=True, check=check, env=env)


def cmd_init(argv):
    url, name, rest = None, None, list(argv)
    while rest:
        a = rest.pop(0)
        if a == "--host":
            if not rest:
                die("--host requiere un nombre")
            name = rest.pop(0)
        elif url is None:
            url = a
        else:
            die(f"argumento desconocido: {a}")
    if not url:
        die("uso: wl init GIT_URL [--host NOMBRE]")
    if url.startswith("-"):
        die(f"URL no válida: {url!r}")
    if name is not None and not valid_host(name):
        die(f"nombre de equipo no válido: {name!r}")
    if root().exists() and any(root().iterdir()):
        die(f"{root()} ya existe y no está vacío")
    r = subprocess.run(["git", "clone", "--", url, str(root())], text=True)
    if r.returncode:
        die("git clone falló", r.returncode)
    if name:
        cfg = config_file()
        cfg.parent.mkdir(parents=True, exist_ok=True)
        cfg.write_text(name + "\n", encoding="utf-8")
    print(f"listo: equipo={host()} datos={root()}")


def cmd_sync(_argv):
    if not (root() / ".git").exists():
        die(f"{root()} no es un repositorio; usa wl init")
    if git("remote", "get-url", "origin").returncode:
        die("el repositorio no tiene remoto 'origin'")
    h = host()
    if (root() / h).is_dir():  # un equipo sin registros propios solo hace pull
        added = git("add", "-A", "--", h)
        if added.returncode:
            die("git add falló\n" + added.stderr.strip())
        # solo este directorio: lo que el usuario tenga en el índice no se arrastra
        if git("diff", "--cached", "--quiet", "--", h).returncode:
            msg = f"worklog: {h} {datetime.now().astimezone():%Y-%m-%d %H:%M}"
            commit = git("commit", "-m", msg, "--", h)
            if commit.returncode:
                die("git commit falló\n" + (commit.stderr.strip() or commit.stdout.strip()))
    dirty = git("status", "--porcelain").stdout.strip()
    if dirty:
        die("hay cambios sin confirmar fuera del directorio de este equipo; "
            "no se sincroniza para no mezclarlos:\n" + dirty)
    remote_has_branch = bool(git("ls-remote", "--heads", "origin").stdout.strip())
    if remote_has_branch:
        pull = git("pull", "--rebase")
        if pull.returncode:
            git("rebase", "--abort")  # no dejar el clon a medio rebase
            die("sin red o conflicto al hacer pull; las entradas están a salvo en local\n"
                + pull.stderr.strip(), 2)
    push = git("push", "-u", "origin", "HEAD")  # -u: también vale para el primer push a un repo vacío
    if push.returncode:
        die("push falló; las entradas están a salvo en local\n" + push.stderr.strip(), 2)
    print("sincronizado")


def cmd_daily(argv):
    vault = day = None
    rest = list(argv)
    while rest:
        a = rest.pop(0)
        if a in ("--vault", "--date"):
            if not rest or rest[0].startswith("--"):
                die(f"{a} requiere un valor")
            if a == "--vault":
                vault = rest.pop(0)
            else:
                day = rest.pop(0)
        else:
            die(f"argumento desconocido: {a}")
    if not vault:
        die("uso: wl daily --vault RUTA [--date AAAA-MM-DD]")
    day = day or date.today().isoformat()
    try:
        date.fromisoformat(day)
    except ValueError:
        die(f"fecha no válida: {day}")
    note = Path(vault).expanduser() / "DAILY" / f"{day}.md"
    if not note.is_file():
        die(f"no existe {note}; la crea el timer de la daily, no este script")
    note = note.resolve()  # si es un enlace simbólico, se actualiza el destino
    entries = load(day, root())
    if not entries:
        print("sin entradas; no se toca la daily")
        return
    mtime = note.stat().st_mtime_ns
    text = note.read_bytes().decode("utf-8")
    eol = "\r\n" if "\r\n" in text else "\n"
    block = render(entries).replace("\n", eol)
    i, j = text.find(START), text.find(END)
    if (i == -1) != (j == -1) or (i != -1 and j < i):
        die("marcadores de worklog incompletos o desordenados en la daily; no se toca")
    if i != -1:
        new = text[:i] + block + text[j + len(END):]
    else:
        new = text.rstrip("\r\n") + eol + eol + block + eol
    if new == text:
        print("sin cambios")
        return
    fd, tmp = tempfile.mkstemp(dir=note.parent, prefix=f".{note.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(new.encode("utf-8"))
        os.chmod(tmp, note.stat().st_mode & 0o777)
        if note.stat().st_mtime_ns != mtime:
            die("la daily cambió mientras se actualizaba; vuelve a ejecutar")
        os.replace(tmp, note)
    finally:
        Path(tmp).unlink(missing_ok=True)
    print(f"{note}: {len(entries)} entradas")


def is_command(argv) -> bool:
    """¿Esto es el subcomando o una frase que casualmente empieza igual?"""
    cmd, rest = argv[0], argv[1:]
    if cmd in ("today", "sync"):
        return not rest
    if cmd == "daily":
        return bool(rest) and rest[0].startswith("--")
    if cmd == "init":
        return bool(rest) and (rest[0] == "--host" or (not rest[0].startswith("-") and (":" in rest[0] or "/" in rest[0])))
    return False


COMMANDS = {"today": cmd_today, "sync": cmd_sync, "init": cmd_init, "daily": cmd_daily}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help") and len(argv) == 1:
        print(__doc__)
        return
    if argv[0] in COMMANDS and is_command(argv):
        COMMANDS[argv[0]](argv[1:])
    else:
        cmd_add(argv)


if __name__ == "__main__":
    main(sys.argv[1:])
