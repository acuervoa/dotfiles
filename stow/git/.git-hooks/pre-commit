#!/usr/bin/env bash
# pre-commit - escaneo de secretos/trazas y bloqueo de ficheros sensibles

set -u
# Debug/trace calls: any mention is suspicious regardless of context.
debug_pattern='(var_dump|print_r|\bdd\(|\bdie\(|console\.log)'
# Secret-looking assignments: only flag when the key is followed by an
# actual non-empty value, not a bare/placeholder variable name (e.g.
# `API_KEY=` in a .env.example must not trip this).
secret_pattern='(API_KEY|PASSWORD|SECRET)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_./+=-]{6,}'

echo "-> pre-commit: escaneando contenido staged..."
files="$(git diff --cached --name-only --diff-filter=ACM |
  grep -E '\.(php|js|ts|env|ini|json|ya?ml|conf|sh)$' || true)"

[ -z "$files" ] && exit 0

fail=0
while IFS= read -r f; do
  if git show ":$f" | grep -nEI "$debug_pattern" -I >/dev/null; then
    echo "❌ Bloqueado: '$f' contiene trazas/debug." >&2
    git show ":$f" | grep -nEI "$debug_pattern" -I >&2 || true
    fail=1
  fi
  if git show ":$f" | grep -nEI "$secret_pattern" -I >/dev/null; then
    echo "❌ Bloqueado: '$f' contiene un posible secreto con valor real." >&2
    git show ":$f" | grep -nEI "$secret_pattern" -I >&2 || true
    fail=1
  fi
done <<EOF
${files}
EOF

for sensitive in ".env" ".env.local" ".env.prod" "docker-compose.override.yml"; do
  if git diff --cached --name-only | grep -Fx "$sensitive" >/dev/null; then
    echo "❌ ERROR: '$sensitive' está staged. No se permite commitear eso." >&2
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo "❌ Commit cancelado. Limpia antes de commitear." >&2
  exit 1
fi

echo "✔ pre-commit OK "

# Additional secret scan (optional)
if [ -z "${SKIP_SECRET_SCAN:-}" ]; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  if [ -x "$repo_root/scripts/check-secrets.sh" ]; then
    "$repo_root/scripts/check-secrets.sh" || exit 1
  fi
fi

exit 0
